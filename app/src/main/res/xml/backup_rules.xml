<?xml version="1.0" encoding="utf-8"?>
<!-- MIZAN is strictly offline-first with device-bound Android Keystore credentials; never back up local user discipline records or vaults. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
